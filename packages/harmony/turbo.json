{
  "extends": ["//"],
  "tasks": {
    "build:css": {
      "inputs": [
        "src/css-entry.ts",
        "src/foundations/**/*.css",
        "rollup.css.config.mjs",
        "rollup.fonts.mjs"
      ],
      "outputs": ["dist/harmony.css", "dist/harmony-no-fonts.css"],
      "outputLogs": "new-only"
    },
    "test": {
      "outputs": ["coverage/**"],
      "outputLogs": "new-only"
    }
  }
}
