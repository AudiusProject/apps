# Same API key as server — so OAuth connects the user to your developer app
EXPO_PUBLIC_AUDIUS_API_KEY=

# URL of the like-repost server (run server first).
# iOS simulator: http://localhost:3002
# Android emulator: http://10.0.2.2:3002
# Physical device: use your computer's LAN IP, e.g. http://192.168.4.107:3002
EXPO_PUBLIC_WRITE_SERVER_URL=http://localhost:3002
