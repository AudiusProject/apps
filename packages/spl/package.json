{
  "name": "@audius/spl",
  "version": "2.0.2",
  "description": "The core Typescript mappings to the Audius Solana Programs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "start": "tsc --build --verbose --watch tsconfig.all.json",
    "build": "tsc --build --verbose tsconfig.all.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "init-reward-manager": "ts-node --project scripts/tsconfig.json scripts/initRewardManager.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AudiusProject/apps/tree/main/packages/spl"
  },
  "author": "Audius",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/AudiusProject/apps/issues"
  },
  "homepage": "https://github.com/AudiusProject/apps/tree/main/packages/spl",
  "dependencies": {
    "@coral-xyz/anchor": "0.29.0",
    "@noble/hashes": "1.4.0",
    "@solana/buffer-layout": "4.0.1",
    "@solana/buffer-layout-utils": "0.2.0",
    "@solana/spl-token": "0.3.8",
    "bs58": "6.0.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.95.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "2.1.1"
  }
