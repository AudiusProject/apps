# From audius.co/settings → Developer Apps
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=
# Required for gated streaming: server signs stream URLs (generate: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))")
SIGNER_PRIVATE_KEY=
# Geo-gating: comma-separated countries (default: United States)
# ALLOWED_COUNTRIES=United States,Canada,United Kingdom
# PORT=3004
