{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [
        "build/**",
        "build-ssr/**",
        "../../node_modules/@brillout/vite-plugin-import-build/dist/autoImporter.js"
      ],
      "dependsOn": [
        "@audius/common#build",
        "@audius/fixed-decimal#build",
        "@audius/harmony#build",
        "@audius/eth#build",
        "@audius/spl#build"
      ],
      "outputLogs": "new-only",
      "env": ["VITE_ENVIRONMENT", "VITE_SSR"]
    },
    "dist": {
      "outputs": ["dist/**"],
      "dependsOn": [
        "@audius/common#build",
        "@audius/fixed-decimal#build",
        "@audius/harmony#build",
        "@audius/eth#build",
        "@audius/spl#build"
      ],
      "outputLogs": "new-only"
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "@audius/common#build",
        "@audius/fixed-decimal#build",
        "@audius/harmony#build",
        "@audius/eth#build",
        "@audius/spl#build"
      ],
      "outputLogs": "new-only"
    }
  }
}
